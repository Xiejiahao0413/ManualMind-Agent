APP_NAME=ManualMind-Agent
APP_ENV=development
LOG_LEVEL=INFO

# Keep provider credentials outside source control.
# MANUALMIND_LLM_PROVIDER=openai
# MANUALMIND_LLM_MODEL=gpt-4o-mini
# MANUALMIND_LLM_TIMEOUT_SECONDS=20
# MANUALMIND_LLM_MAX_TOKENS=900
# MANUALMIND_LLM_TEMPERATURE=0.2
# OPENAI_API_KEY=
# LLM_ENABLED=true
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MANUALMIND_VECTOR_BACKEND=memory
# MANUALMIND_EMBEDDING_PROVIDER=mock
# MANUALMIND_EMBEDDING_MODEL=text-embedding-3-small
# MANUALMIND_EMBEDDING_DIMENSION=64
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=your_milvus_token_here
# MANUALMIND_MILVUS_COLLECTION=manualmind_chunks
